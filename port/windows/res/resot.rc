// Icon and version information of the Windows executables.
#include <winres.h>
#include "../../game/resot_version.h"

// The first icon in the file is the one Explorer shows.
1 ICON "resot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RESOT_VERSION_PARTS
 PRODUCTVERSION RESOT_VERSION_PARTS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "reSOT - Prince of Persia: The Sands of Time (Xbox) recompiled"
            VALUE "ProductName", "reSOT"
            VALUE "FileVersion", RESOT_VERSION
            VALUE "ProductVersion", RESOT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The launcher (src/launcher.c): the logo in two layers (its letters, and the
// sand around them, which the launcher animates), and the Atlantis MF face for
// its title and buttons when the build found res/AtlantisMF.ttf (CMakeLists.txt).
202 RCDATA "../../../docs/media/reSOT_letters.png"
204 RCDATA "../../../docs/media/reSOT_sand.png"
203 RCDATA "../default-options.ini"
#ifdef RESOT_HAVE_LAUNCHER_FONT
201 RCDATA "AtlantisMF.ttf"
#endif
