// Icon and version information of the Windows executables.
#include <winres.h>

// The first icon in the file is the one Explorer shows.
1 ICON "resot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "reSOT - Prince of Persia: The Sands of Time (Xbox) recompiled"
            VALUE "ProductName", "reSOT"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
