# The user's own game files.
/Assets/
# Analysis databases, Ghidra projects and notes that quote the binaries.
/research/
# Outputs.
/bin/
/build*/
/logs/
/xbox_kernel.log
resot-options.ini
# Android (port/android): Gradle and NDK outputs, the SDK location, APKs.
/port/android/.gradle/
/port/android/build/
/port/android/app/build/
/port/android/app/.cxx/
/port/android/local.properties
*.apk
*.aab
/port/third_party/xboxrecomp/tools/*/output/
/port/third_party/xboxrecomp-demo/tools/*/output/
/port/third_party/xboxrecomp-retail/tools/*/output/
# Executables and debug databases, wherever they land.
*.exe
*.pdb
*.xbe
# (but xboxrecomp's synthetic conformance image, built by its mkxbe.py)
!/port/third_party/xboxrecomp/tools/conformance/test.xbe
# Caches and IDE files.
# Host shader caches can contain translated programs from the user's XBE.
shadercache/
__pycache__/
*.pyc
.pytest_cache/
*.user
.vs/
.idea/
compile_commands.json
